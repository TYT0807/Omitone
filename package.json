{
  "name": "omitone",
  "version": "1.3.2",
  "private": true,
  "description": "学习通（chaoxing）课程自动化浏览器扩展：视频/音频播放、PPT 翻页、AI 答题、验证码识别、讨论任务点",
  "license": "GPL-3.0",
  "scripts": {
    "test": "node tools/check.js && node tools/prompt-bench.js && node tools/integration-test.js && node tools/background-test.js && node omitone-regression.cjs && node omitone-regression.cjs --self-test && node omitone-fuzz-test.cjs && node omitone-pet-game-test.cjs && node omitone-log-store-test.cjs && node omitone-popup-log-test.cjs && node omitone-update-plan-test.cjs && node omitone-acceptance-test.cjs",
    "check": "node tools/check.js",
    "concat": "node tools/concat-page.js",
    "concat:check": "node tools/concat-page.js --check",
    "bench": "node tools/prompt-bench.js",
    "itest": "node tools/integration-test.js",
    "bgtest": "node tools/background-test.js",
    "regression": "node omitone-regression.cjs",
    "regression:self-test": "node omitone-regression.cjs --self-test",
    "log-store:test": "node omitone-log-store-test.cjs",
    "popup-log:test": "node omitone-popup-log-test.cjs",
    "update-plan:test": "node omitone-update-plan-test.cjs",
    "sandbox": "node omitone-sandbox.cjs --full",
    "sandbox:built": "node omitone-sandbox.cjs --full --built",
    "acceptance:test": "node omitone-acceptance-test.cjs",
    "acceptance:built": "node omitone-acceptance.cjs",
    "e2e": "node tools/browser-e2e.js",
    "clean:profiles": "node tools/clean-e2e-profiles.js --apply",
    "clean:profiles:dry": "node tools/clean-e2e-profiles.js",
    "clean:profiles:selftest": "node tools/clean-e2e-profiles.js --selftest",
    "field-browser": "node tools/field-browser.js",
    "field-shape": "node tools/debug-probe.js --port=9334 --match=chaoxing --file=tools/field-shape.expr",
    "field-space": "node tools/debug-probe.js --port=9334 --match=space/index --file=tools/field-space-index.expr",
    "field-logs": "node tools/field-logs.js",
    "field-logs:selftest": "node tools/field-logs.js --selftest",
    "field-bridge": "node tools/field-bridge.js",
    "field-bridge:selftest": "node tools/field-bridge.js --selftest",
    "concurrency": "node tools/check-concurrency.js",
    "theme": "node tools/audit-dark-theme.js",
    "theme:selftest": "node tools/audit-dark-theme.js --selftest",
    "concurrency:selftest": "node tools/check-concurrency.js --selftest",
    "test:all": "npm test && npm run e2e",
    "build": "node tools/build.js",
    "manual": "node tools/manual-pdf.js",
    "release": "node tools/github-release.js",
    "audit:publish": "node tools/publish-audit.js",
    "pet-game:test": "node omitone-pet-game-test.cjs",
    "fuzz:test": "node omitone-fuzz-test.cjs"
  },
  "engines": {
    "node": ">=18"
  }
}
